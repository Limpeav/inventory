# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# WebSocket Endpoint
NEXT_PUBLIC_WS_URL=http://localhost:8080/api/v1/ws

# Production (set these in your deployment settings e.g. Vercel dashboard):
# Make sure to use https:// and wss:// in production
# NEXT_PUBLIC_API_URL=https://inventory-backend.example.com/api/v1
# NEXT_PUBLIC_WS_URL=https://inventory-backend.example.com/api/v1/ws
