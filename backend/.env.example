# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (Rename to .env or configure in deployment platform)
# ==============================================================================

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/inventory_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Security (Generate a secure 256-bit base64 key for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000

# Initial Admin Seeding (Set APP_SEED_ENABLED=false after first deployment)
APP_SEED_ENABLED=true
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@inventory.com
APP_ADMIN_PASSWORD=your_strong_admin_password_here
APP_ADMIN_FULLNAME=System Administrator

# Email Configuration (Gmail SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-gmail-address@gmail.com
SPRING_MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_FROM=your-gmail-address@gmail.com
MAIL_SENDER_NAME=Inventory Management

# Frontend Base URL (used to generate password reset links)
FRONTEND_BASE_URL=http://localhost:3000

